# Copy to .env (which is gitignored) and fill in. Never commit .env.

# Your local PostgreSQL password.
DB_PASSWORD=change-me

# Base64-encoded random key of at least 32 bytes. Generate your own:
#   openssl rand -base64 32
#   PowerShell (uses the OS cryptographic RNG; don't use Get-Random for keys):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Local development over plain http://localhost only. Leave unset (true) anywhere else.
COOKIE_SECURE=false

# Optional overrides
# DB_URL=jdbc:postgresql://localhost:5432/fitness_buddy
# DB_USERNAME=postgres
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
